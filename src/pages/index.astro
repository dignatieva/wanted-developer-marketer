---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Poster from '../components/Poster.astro';
import Letter from '../components/Letter.astro';
import ChargeSheet from '../components/ChargeSheet.astro';
import Closing from '../components/Closing.astro';
import Cv from '../components/Cv.astro';
import { suspect } from '../data/dossier';
---

<Layout
  title={`WANTED: ${suspect.role} — ${suspect.name}`}
  description={`A reply to PostHog's notice for a ${suspect.role}. Six charges, all pleaded guilty, evidence attached.`}
>
  <TopBar />
  <main>
    {/*
      Both views ship in the HTML and CSS picks one, so switching is instant and
      needs no JavaScript. Boring mode is no longer the poster restyled — it is
      the actual CV, which is what someone reading forty applications wants.
    */}
    <div class="only-poster">
      <Poster />
      <Letter />
      <ChargeSheet />
      <Closing />
    </div>

    <Cv />
  </main>
</Layout>
