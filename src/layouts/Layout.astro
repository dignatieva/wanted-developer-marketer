---
// Latin subsets only. The defaults ship Cyrillic, Vietnamese and legacy .woff
// too, which quadruples the font payload for glyphs this page never renders.
import '@fontsource/rye/latin-400.css';
import '@fontsource/bevan/latin-400.css';
import '@fontsource/special-elite/latin-400.css';
// No 700 weight: nothing in the body copy is bold — headings all use Rye or
// Bevan. Add it back if you ever put a <strong> inside a paragraph.
import '@fontsource/libre-baskerville/latin-400.css';
import '@fontsource/libre-baskerville/latin-400-italic.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" data-mode="poster">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Daryna Rodriguez" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23efe2c6'/%3E%3Ctext x='16' y='24' font-size='22' font-family='Georgia,serif' text-anchor='middle' fill='%23b3210b'%3EW%3C/text%3E%3C/svg%3E"
    />

    {/* Restore the reader's chosen skin before first paint, so it never flashes. */}
    <script is:inline>
      try {
        const saved = localStorage.getItem('wanted-mode');
        if (saved === 'plain' || saved === 'poster') {
          document.documentElement.dataset.mode = saved;
        }
      } catch (e) {
        /* private browsing, no preference to restore */
      }
    </script>

    {/*
      Optional self-instrumentation. Add PUBLIC_POSTHOG_KEY to .env and the page
      starts reporting on itself; leave it unset and this chunk never loads.
    */}
    <script>
      const key = import.meta.env.PUBLIC_POSTHOG_KEY;

      if (key) {
        const { default: posthog } = await import('posthog-js');

        posthog.init(key, {
          // First-party by default. /ingest is rewritten to PostHog by
          // vercel.json, so the browser only ever talks to this origin: nothing
          // for a tracking blocker to recognise, and no third-party request.
          // posthog-js itself is bundled from npm, so no external script either.
          api_host: import.meta.env.PUBLIC_POSTHOG_HOST ?? '/ingest',
          // Where the real PostHog lives. Only used to build links out to the
          // app (toolbar, replay); never contacted for data.
          ui_host: 'https://eu.posthog.com',
          defaults: '2025-05-24',
          // The preset uses 'identified_only', which creates a person profile
          // only for identified users. Every reader of this page is anonymous, so
          // that would produce events with nobody attached to them.
          person_profiles: 'always',
        });

        window.posthog = posthog;

        // Which skin they read it in. mode_toggled only fires on a change, so
        // without this the default-mode readers are invisible.
        posthog.register({
          initial_mode: document.documentElement.dataset.mode ?? 'poster',
        });

        // PostHog cannot put a name to an anonymous visitor. Sending each person
        // a link with ?from=… is the only reliable way to tell them apart, so it
        // rides along on every event and becomes the person's identity.
        const from = new URLSearchParams(location.search).get('from');
        if (from) {
          posthog.register({ invited_as: from });
          posthog.identify(`invite:${from}`, { invited_as: from });
        }

        // --- Read depth ---
        // How far someone actually got is the most interesting thing this page
        // can report, and clicks say nothing about it. Derived from the existing
        // DOM so no markup has to carry tracking attributes.
        const marks: { el: Element; name: string }[] = [];

        document.querySelectorAll('.charge').forEach((el) => {
          const n = el.querySelector('.charge__n')?.textContent?.trim();
          if (n) marks.push({ el, name: `charge-${n}` });
        });

        const claim = document.querySelector('#claim');
        if (claim) marks.push({ el: claim, name: 'the-end' });

        const seen = new Set<string>();

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;

              const mark = marks.find((m) => m.el === entry.target);
              if (!mark || seen.has(mark.name)) continue;

              seen.add(mark.name);
              observer.unobserve(entry.target);

              posthog.capture('section_viewed', {
                section: mark.name,
                sections_seen: seen.size,
              });

              if (mark.name === 'the-end') {
                posthog.capture('read_to_the_end', { sections_seen: seen.size });
              }
            }
          },
          // Two fifths visible: enough to mean "read", not merely "scrolled past".
          { threshold: 0.4 }
        );

        marks.forEach((m) => observer.observe(m.el));
      }
    </script>
  </head>

  <body>
    <slot />
  </body>
</html>
