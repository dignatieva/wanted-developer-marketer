---
import { suspect } from '../data/dossier';
---

<div class="bar no-print">
  <div class="bar__inner">
    <p class="bar__id">
      <span class="bar__flag" aria-hidden="true">✦</span>
      Reply to notice <a class="bar__notice" href={suspect.jobUrl} target="_blank" rel="noreferrer"
        ><span class="bar__proto">https://</span>posthog.com/careers/developer-marketer</a
      >
      <span class="bar__sep" aria-hidden="true">·</span>
      <span class="bar__from">filed by {suspect.name}</span>
    </p>

    <button type="button" class="bar__toggle" data-mode-toggle aria-live="polite">
      <span class="only-poster"
        ><span class="bar__long">Boring CV mode</span><span class="bar__short">CV mode</span></span
      >
      <span class="only-plain"
        ><span class="bar__long">Wanted poster mode</span><span class="bar__short">Poster</span></span
      >
    </button>
  </div>
</div>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-mode-toggle]');

  toggle?.addEventListener('click', () => {
    const next = root.dataset.mode === 'plain' ? 'poster' : 'plain';
    root.dataset.mode = next;

    try {
      localStorage.setItem('wanted-mode', next);
    } catch (e) {
      /* no preference to persist, no problem */
    }

    // If a PostHog key is configured, this is genuinely the most interesting
    // event on the page: did they want the fun one or the readable one?
    window.posthog?.capture('mode_toggled', { mode: next });
  });
</script>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    color: var(--paper-lit);
    border-bottom: 2px solid var(--ink);
  }

  :root[data-mode='plain'] .bar {
    background: var(--paper);
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule);
  }

  .bar__inner {
    width: min(100% - 2rem, 62rem);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.75rem;
    padding-block: 0.4rem;
  }

  .bar__id {
    margin: 0;
    font-family: var(--ui);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* A URL read aloud in caps is not a URL. Drops the bar's uppercase and its
     wide tracking so the address stays scannable at 11px. */
  .bar__notice {
    font-weight: 700;
    color: var(--yellow);
    text-transform: none;
    letter-spacing: 0.02em;
    text-underline-offset: 2px;
  }

  :root[data-mode='plain'] .bar__notice {
    color: var(--blue);
  }

  .bar__flag {
    color: var(--red);
    margin-right: 0.35rem;
  }

  .bar__sep {
    opacity: 0.5;
    margin-inline: 0.35rem;
  }

  .bar__toggle {
    font-family: var(--ui);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink);
    background: var(--yellow);
    border: 2px solid var(--paper-lit);
    border-radius: 3px;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
  }

  .bar__toggle:hover {
    background: var(--paper-lit);
  }

  :root[data-mode='plain'] .bar__toggle {
    background: transparent;
    color: var(--blue);
    border-color: var(--rule);
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 0.75rem;
  }

  :root[data-mode='plain'] .bar__toggle:hover {
    background: var(--paper-deep);
  }

  /* The address is the longest thing in the bar, so it sheds weight first:
     protocol goes, then the byline, before anything is allowed to overflow. */
  /* 52rem, not 48: the full line needs ~816px of viewport to stay on one row,
     and the bar wrapping to two lines shoves the poster down on every scroll. */
  @media (max-width: 52rem) {
    .bar__proto {
      display: none;
    }
  }

  .bar__short {
    display: none;
  }

  @media (max-width: 34rem) {
    .bar__from,
    .bar__sep {
      display: none;
    }

    /* A phone cannot fit the address next to a full-width toggle, and the
       address is the part worth keeping whole — so the button gives up its
       words and the bar gives up its tracking, which buys the URL a second
       line instead of a third. */
    .bar__long {
      display: none;
    }

    .bar__short {
      display: inline;
    }

    .bar__id {
      letter-spacing: 0.05em;
    }

    .bar__notice {
      letter-spacing: 0;
      /* The address only breaks at / and -, which strands half a line. Breaking
         anywhere packs it onto two rows instead of three. */
      word-break: break-all;
    }
  }
</style>
