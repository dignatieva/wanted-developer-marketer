---
import { Image } from 'astro:assets';
import { closing, suspect } from '../data/dossier';
---

<section class="close" id="claim">
  <div class="wrap wrap--tight">
    <div class="close__card">
      <p class="overline">Claim the reward</p>
      <h2 class="close__title display letterpress">{closing.heading}</h2>

      <p class="close__p lede">{closing.intro}</p>

      {/*
        Text and photo share a row on wide screens so the picture lands beside
        the tortoise line rather than after the punchline about pizza. On a
        phone the photo drops below the list, where it reads as a sign-off.
      */}
      <div class="close__aside">
        <ul class="close__list">
          {closing.asides.map((item) => <li>{item}</li>)}
        </ul>

        <figure class="close__photo">
          <span class="close__tape" aria-hidden="true"></span>
          <Image
            src={closing.photo.src}
            alt={closing.photo.alt}
            widths={[260, 520]}
            sizes="(max-width: 44rem) 70vw, 240px"
            loading="lazy"
          />
          <figcaption class="close__cap">{closing.photo.caption}</figcaption>
        </figure>
      </div>

      <div class="close__actions">
        <a class="btn btn--red" href={`mailto:${suspect.email}?subject=Re: Notice %23${suspect.noticeId}`} data-contact>
          Bring her in
        </a>
        <button type="button" class="btn no-print" data-print>Print the poster</button>
      </div>

      <dl class="close__links">
        {
          suspect.links.map((l) => (
            <div class="close__link">
              <dt>{l.label}</dt>
              <dd>
                <a class="link" href={l.href} target="_blank" rel="noreferrer">
                  {l.text}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    <footer class="foot">
      <p class="foot__ps">{closing.ps}</p>
    </footer>
  </div>
</section>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => {
    window.posthog?.capture('poster_printed');
    window.print();
  });

  document.querySelector('[data-contact]')?.addEventListener('click', () => {
    window.posthog?.capture('contact_initiated', { method: 'email' });
  });
</script>

<style>
  .close {
    padding: clamp(2.5rem, 7vw, 4.5rem) 0 clamp(2rem, 5vw, 3rem);
  }

  .close__card {
    position: relative;
    background: var(--paper-lit);
    border: 4px double var(--ink);
    padding: clamp(1.5rem, 5vw, 3rem);
    box-shadow: 6px 6px 0 rgba(36, 28, 20, 0.14);
  }

  :root[data-mode='plain'] .close__card {
    border: 1px solid var(--rule);
    border-radius: 10px;
    box-shadow: none;
  }

  .close__title {
    margin: 0.5rem 0 1.1rem;
    font-size: clamp(1.625rem, 5.5vw, 2.75rem);
    line-height: 1;
  }

  :root[data-mode='plain'] .close__title {
    font-size: clamp(1.375rem, 4vw, 1.875rem);
    font-weight: 700;
    text-transform: none;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .close__p {
    margin: 0 0 0.85rem;
  }

  /* --- The unlisted qualifications --- */
  /* flow-root, not grid: a side column would pin every item to ~38 characters
     a line. Floating lets the photo sit against the tortoise entry and hands
     the full measure back to the entries below it. */
  .close__aside {
    display: flow-root;
    margin-top: 0.4rem;
  }

  .close__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
    min-width: 0;
  }

  .close__list li {
    /* Hanging indent so a wrapped line aligns under its own text, not the mark. */
    padding-left: 1.1rem;
    text-indent: -1.1rem;
    line-height: 1.6;
  }

  .close__list li::before {
    content: '✦';
    color: var(--red);
    margin-right: 0.5rem;
  }

  :root[data-mode='plain'] .close__list li::before {
    content: '–';
    color: var(--ink-faint);
  }

  /* --- Photo --- */
  .close__photo {
    position: relative;
    float: right;
    width: 13rem;
    margin: 0.2rem 0 1rem 1.75rem;
    background: var(--paper-lit);
    padding: 0.6rem 0.6rem 0;
    border: 1px solid var(--rule);
    rotate: 1.6deg;
    box-shadow: 0 14px 30px -18px rgba(36, 28, 20, 0.75);
  }

  .close__photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* Crops toward the top: the tortoise and her face live in the upper half,
       and a centre crop gives the frame a lot of empty gravel. */
    object-position: 50% 32%;
    filter: sepia(0.24) saturate(0.88);
  }

  :root[data-mode='plain'] .close__photo {
    rotate: none;
    border-radius: 8px;
    box-shadow: none;
  }

  :root[data-mode='plain'] .close__photo :global(img) {
    filter: none;
    border-radius: 4px;
  }

  .close__tape {
    position: absolute;
    top: -0.6rem;
    left: 50%;
    translate: -50% 0;
    width: 4.5rem;
    height: 1.4rem;
    rotate: -2deg;
    background: rgba(214, 178, 92, 0.4);
    border-left: 1px solid rgba(214, 178, 92, 0.6);
    border-right: 1px solid rgba(214, 178, 92, 0.6);
  }

  :root[data-mode='plain'] .close__tape {
    display: none;
  }

  .close__cap {
    padding: 0.55rem 0.15rem 0.6rem;
    font-family: var(--annotation);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--ink-soft);
    text-align: center;
  }

  :root[data-mode='plain'] .close__cap {
    font-family: var(--ui);
    font-size: 0.75rem;
    text-align: left;
    color: var(--ink-faint);
  }

  /* Below this the card is too narrow for text to flow beside the photo at all,
     so it stops floating and becomes a sign-off under the list. */
  @media (max-width: 44rem) {
    .close__photo {
      float: none;
      width: min(70%, 15rem);
      margin: 1.25rem auto 0;
    }
  }

  .close__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
  }

  .close__links {
    margin: clamp(1.5rem, 4vw, 2rem) 0 0;
    padding-top: clamp(1.1rem, 3vw, 1.5rem);
    border-top: 3px double var(--ink);
    display: grid;
    gap: 0.6rem;
  }

  :root[data-mode='plain'] .close__links {
    border-top: 1px solid var(--rule);
  }

  .close__link {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 0.15rem 1rem;
    align-items: baseline;
  }

  .close__link dt {
    font-family: var(--ui);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .close__link dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: break-word;
  }

  /* --- Footer --- */
  .foot {
    margin-top: clamp(1.75rem, 5vw, 2.5rem);
    text-align: center;
  }

  .foot__ps {
    margin: 0;
    font-size: 1rem;
    color: var(--ink);
  }

  @media (max-width: 30rem) {
    .close__link {
      grid-template-columns: 1fr;
    }
  }
</style>
